{
  "name": "visibility-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:routes": "node src/routes.test.mjs",
    "format": "prettier --write src vite.config.ts index.html package.json tsconfig.json",
    "format:check": "prettier --check src vite.config.ts index.html package.json tsconfig.json"
  },
  "dependencies": {
    "@d3-maps/atlas": "1.0.1",
    "d3-geo": "3.1.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
