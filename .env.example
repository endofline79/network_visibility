# Verified AI-02 LAN address for syslog.
SYSLOG_BIND_ADDRESS=192.168.5.230
SYSLOG_PORT=514

# The query API is published on AI-02 loopback only.
QUERY_PORT=9428
FLOW_DATA_DIR=/home/klab/.local/share/visibility/flows

# Keep collected logs on AI-02's large /home filesystem.
# Create this directory as klab before starting Compose.
LOG_DATA_DIR=/home/klab/.local/share/visibility/victorialogs
VISIBILITY_UID=1000
VISIBILITY_GID=1000

# The custom dashboard is available to the trusted LAN; no Internet port forward.
DASHBOARD_BIND_ADDRESS=192.168.5.230
DASHBOARD_PORT=8095
DASHBOARD_ALLOWED_HOSTS=192.168.5.230,ai-02,localhost,127.0.0.1
FIREWALL_SOURCE_IP=192.168.5.1
LOCAL_NETWORKS=192.168.5.0/24,10.10.10.0/24,10.10.20.0/24
GEOIP_DATA_DIR=/home/klab/.local/share/visibility/geoip
# User-selected city-level map anchor, not a street address.
LAB_LOCATION_LABEL=Rochester, NY
LAB_LATITUDE=43.1566
LAB_LONGITUDE=-77.6088

# Jev is OFF on every dashboard start; the UI enables bounded continuous or manual runs.
# The API key is a server-only file: ${VISIBILITY_SECRETS_DIR}/typesafe_api_key.
# Create these directories as klab. Never put the key in the repository.
JEV_DATA_DIR=/home/klab/.local/share/visibility/dashboard
VISIBILITY_SECRETS_DIR=/home/klab/.local/share/visibility/secrets

# Local, read-only UniFi inventory; polls about once a minute, no AI calls.
# Existing UOS_API_KEY is stored in ${VISIBILITY_SECRETS_DIR}/unifi_api_key.
UNIFI_INVENTORY_ENABLED=true
UNIFI_SITE_ID=88f7af54-98f8-306a-a1c7-c9349722b1f6
# Public certificate pin verified through the controller's trusted SSH connection.
UNIFI_CERT_SHA256=d961dfaf1d91c5790388c30a2a4de90d90990ddb15275e33b0aae6630dac3d40

# Local Pi-hole API polling and DNS archive forwarding. No DNS settings writes.
# Phase agents / Production /pi-hole: PI-HOLE_APP_PASS is installed as a file.
PIHOLE_ENABLED=true
PIHOLE_CERT_SHA256=340389c84066e34b861bdbc1df06d3ec1e978aa3debe955593f4eec6d6bdaec1

# Headless API: token comes from Phase agents / Production /, not this file.
TELEMETRY_BIND_ADDRESS=192.168.5.230
TELEMETRY_API_PORT=9429
TELEMETRY_API_SECRETS_DIR=/home/klab/.local/share/visibility/telemetry-api

# Alert checker state, public certs, and the Docker socket group.
# Secret files (mode 0600, never committed) live in VISIBILITY_SECRETS_DIR:
# alert_insert_token, alert_webhook_url, alert_webhook_key.
# DOCKER_GID is `stat -c %g /var/run/docker.sock` on AI-02.
ALERTER_STATE_DIR=/home/klab/.local/share/visibility/alerter
VISIBILITY_CERTS_DIR=/home/klab/.local/share/visibility/certs
PRESENTATION_CA_FILE=/home/klab/.local/share/visibility/presentation/dashboard-ca.crt
DOCKER_GID=
